<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework Condition="'$(SitemapConsumerTargetFramework)' != ''">$(SitemapConsumerTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(SitemapConsumerTargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SitemapPackageVersion Condition="'$(SitemapPackageVersion)' == ''">2.0.2</SitemapPackageVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
    <ProjectReference Include="../Consumer.Client/Consumer.Client.csproj" />
    <PackageReference Include="PinguApps.BlazorSitemap" Version="$(SitemapPackageVersion)" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="PinguApps.BlazorSitemap" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
    <ProjectReference Include="../Consumer.Library/Consumer.Library.csproj" />
  </ItemGroup>
</Project>
