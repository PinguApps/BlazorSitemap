<Project>
  <PropertyGroup>
    <SitemapPackageVersion Condition="'$(SitemapPackageVersion)' == ''">2.0.2</SitemapPackageVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="PinguApps.BlazorSitemap" Version="$(SitemapPackageVersion)" />
    <PackageVersion Include="PinguApps.BlazorSitemap.Abstractions" Version="$(SitemapPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>
</Project>
